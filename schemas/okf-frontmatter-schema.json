{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleOKFFrontmatter",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["JUNOS Base Config", "JUNOS Audit", "meta"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "resource": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "timestamp": { "type": "string" },
    "id": { "type": "string", "pattern": "^KP-(SYS|SEC|INT|RT|PRO|META)-\\d{3}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "verification_method": { "type": "string", "enum": ["cli-regex", "xml-xpath"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "expected": { "type": "string" },
          "negate": { "type": "boolean" },
          "remediation": { "type": "string" }
        },
        "required": ["name", "command", "expected"]
      }
    }
  },
  "required": ["type", "title", "description", "resource", "tags", "timestamp", "id", "version"]
}
