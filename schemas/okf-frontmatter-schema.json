{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleOKFv02Frontmatter",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["JUNOS Base Config", "JUNOS Audit", "meta"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "resource": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string", "pattern": "^KP-(SYS|SEC|INT|RT|PRO|META)-\\d{3}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "stable", "deprecated"] },
    "stale_after": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated": {
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string" }
      },
      "required": ["by", "at"]
    },
    "verified": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "by": { "type": "string" },
            "at": { "type": "string" }
          },
          "required": ["by", "at"]
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "by": { "type": "string" },
              "at": { "type": "string" }
            },
            "required": ["by", "at"]
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "resource": { "type": "string" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "usage_count": { "type": "integer" },
          "last_modified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "required": ["resource"]
      }
    },
    "verification_method": { "type": "string", "enum": ["cli-regex", "xml-xpath"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "expected": { "type": "string" },
          "negate": { "type": "boolean" },
          "remediation": { "type": "string" }
        },
        "required": ["name", "command", "expected"]
      }
    }
  },
  "required": ["type", "title", "description", "resource", "tags", "generated", "id", "version"]
}
